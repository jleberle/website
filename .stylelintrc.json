{
  "extends": "stylelint-config-standard",
  "rules": {
    "no-descending-specificity": null,
    "selector-class-pattern": [
      "^([a-z][a-z0-9]*)(-[a-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?$|^searchResults$",
      {
        "message": "Expected kebab-case, an optional BEM --modifier, or the legacy vendored name (searchResults) tied to matching JS/templates"
      }
    ],
    "property-no-vendor-prefix": [
      true,
      {
        "ignoreProperties": ["-webkit-text-size-adjust", "-webkit-appearance"]
      }
    ],
    "value-keyword-case": [
      "lower",
      {
        "camelCaseSvgKeywords": true,
        "ignoreProperties": ["--meta-font"]
      }
    ]
  }
}
