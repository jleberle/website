{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/*.pdf" } },
          { "not": { "selector_matches": "[rel~=nofollow], [download], [target=_blank]" } }
        ]
      },
      "eagerness": "conservative"
    }
  ]
}
