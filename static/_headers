*
    Cache-Control: public, max-age=3600, stale-while-revalidate=86400
    X-Content-Type-Options: nosniff
    X-Frame-Options: DENY
    Referrer-Policy: no-referrer
    Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
    Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BpEdBCM/4BJbN8LWEqCQKlp9VGzetdD0UbdMayNyD28=' 'sha256-UBD9lfFHKxagKGHh9S8B2hytN1cmDsFK1Tl1uedsZ0Q=' 'sha256-/cFFbEHjTjpj7DLefsC+h1yhrxRRebLCB86XtBuCtvw=' https://embed.bsky.app; style-src 'self' 'sha256-TzlBu+Yp5QndAbgUwjajid8QyFloMLEZVV3SLr0syao=' 'sha256-FGec11lwsCO51tU7WzO3jldp5wRvWMBQbCXewZUQH9k='; frame-src https://www.youtube-nocookie.com https://embed.bsky.app; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; script-src-attr 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests
    Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=(), join-ad-interest-group=(), run-ad-auction=()
    Cross-Origin-Opener-Policy: same-origin
    Cross-Origin-Resource-Policy: same-origin
    X-Permitted-Cross-Domain-Policies: none
    X-Robots-Tag: noai, noimageai

/assets/*
    Cache-Control: public, max-age=31536000, immutable

/js/*
    Cache-Control: public, max-age=31536000, immutable

/fonts/*
    Cache-Control: public, max-age=31536000, immutable

/images/*.avif
    Cache-Control: public, max-age=31536000, immutable

/images/*.jpg
    Cache-Control: public, max-age=31536000, immutable

/articles/*/*.avif
    Cache-Control: public, max-age=31536000, immutable

/articles/*/*.jpg
    Cache-Control: public, max-age=31536000, immutable

/reviews/*/*.avif
    Cache-Control: public, max-age=31536000, immutable

/reviews/*/*.jpg
    Cache-Control: public, max-age=31536000, immutable

/courses/*/*.avif
    Cache-Control: public, max-age=31536000, immutable

/courses/*/*.jpg
    Cache-Control: public, max-age=31536000, immutable

/contact/*.avif
    Cache-Control: public, max-age=31536000, immutable

/articles/*/*.pdf
    Cache-Control: public, max-age=31536000, stale-while-revalidate=2592000

/cv/*.pdf
    Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/favicon.ico
    Cache-Control: public, max-age=31536000, stale-while-revalidate=2592000

/icons/*
    Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000

/*.xml
    Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/robots.txt
    Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/key.asc
    Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/.well-known/*
    Cache-Control: public, max-age=604800, stale-while-revalidate=86400
