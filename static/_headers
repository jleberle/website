/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-YobkNjC2mmpkmYLJJYy1uJyu4hhHZY9q9232p0OOGEE='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; frame-src 'self'; object-src 'none'; script-src-attr 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=(), join-ad-interest-group=(), run-ad-auction=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-Permitted-Cross-Domain-Policies: none
  X-Robots-Tag: noai, noimageai
  tdm-reservation: 1
  tdm-policy: https://jaredeberle.org/ai.txt
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml", </index.xml>; rel="alternate"; type="application/rss+xml"; title="RSS", </feed.json>; rel="alternate"; type="application/feed+json"; title="JSON Feed", </.well-known/security.txt>; rel="security"

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/articles/*.avif
  Cache-Control: public, max-age=31536000, immutable

/articles/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/reviews/*.avif
  Cache-Control: public, max-age=31536000, immutable

/reviews/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/courses/*.avif
  Cache-Control: public, max-age=31536000, immutable

/courses/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/about/*.avif
  Cache-Control: public, max-age=31536000, immutable

/articles/*.pdf
  Cache-Control: public, max-age=31536000, immutable

/cv/*.pdf
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/index.xml
  Cache-Control: public, max-age=0, must-revalidate

/reading/index.xml
  Cache-Control: public, max-age=0, must-revalidate

/feed.json
  Cache-Control: public, max-age=0, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/key.asc
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/.well-known/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Raw Markdown source endpoints (spec: markdown-source-endpoints). Hugo emits
# these as plain .md files; the host needs to be told the content type since
# it can't infer text/markdown from the extension the way it does text/html.
/*.md
  Content-Type: text/markdown; charset=utf-8
