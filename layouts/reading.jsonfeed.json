{{- /* JSON Feed sibling to reading.rss.xml, built to test whether Micro.blog's
       feed importer — the one that turns reading.rss.xml's items into posts
       on eberle.blog — behaves the same way against a JSON Feed source. Not
       currently subscribed to anywhere; reading.rss.xml stays authoritative
       until this has been observed working.

       WINDOW IS DELIBERATELY 1, NOT services.rss.limit. reading.rss.xml's
       window (10) is a blast-radius bound for an established, trusted
       subscription: Micro.blog dedupes on <link>, so a slipped link change
       there can only reimport up to 10 items. This feed's risk is different
       and larger — it's an UNTESTED source about to be pointed at for the
       first time, and it isn't confirmed that Micro.blog's per-link dedup
       (observed only within reading.rss.xml — see that file's header on the
       Blood Countess collision) even applies across a feed-URL swap rather
       than being scoped to the subscription that first delivered a link. If
       it doesn't, subscribing at the normal window would re-import every
       item currently in reading.rss.xml's window as a duplicate post, same
       failure as the 2026-07/08 cleanups. Capping to 1 means the worst case
       of that swap, if the dedup theory is wrong, is a single duplicate —
       and if the swap happens right after a new started/finished event is
       added, that single item is guaranteed to be the untested one, not a
       rehash of history. See docs/reading.md.

       id/url intentionally match reading.rss.xml's <link> exactly (same
       permalink + #started/#finished suffix) so that if Micro.blog's dedup
       does carry across feed URLs, already-imported events are recognized
       and skipped rather than recreated. */ -}}
{{- $authorName := site.Params.author }}
{{- $events := partial "templates/_funcs/reading_events.html" . -}}
{{- $events = first 1 $events -}}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ printf "%s | %s" .Title site.Title | jsonify }},
  "description": {{ .Description | default (printf "Reading activity from %s" site.Title) | jsonify }},
  "language": {{ site.Language.Lang | jsonify }},
  "home_page_url": {{ .Permalink | jsonify }},
  "feed_url": {{ printf "%sfeed.json" .Permalink | jsonify }},
  {{- with site.Params.websubHub }}
  "hubs": [{ "type": "WebSub", "url": {{ . | jsonify }} }],
  {{- end }}
  {{- with partial "templates/_funcs/feed_icon.html" . }}
  "icon": {{ . | jsonify }},
  {{- end }}
  "favicon": {{ (print site.BaseURL "favicon.ico") | jsonify }},
  {{- with $authorName }}
  "authors": [{ "name": {{ . | jsonify }}, "url": {{ site.BaseURL | jsonify }} }],
  {{- end }}
  "items": [
    {{- range $i, $e := $events }}
    {{- if $i }},{{ end }}
    {{- $body := partial "templates/_funcs/reading_item_body.html" $e -}}
    {{- $link := printf "%s%s" $e.permalink (cond (ne $e.linkSuffix "") (printf "#%s" $e.linkSuffix) "") -}}
    {
      "id": {{ $link | jsonify }},
      "url": {{ $link | jsonify }},
      "title": {{ printf "%s: %s" $body.action $e.title | jsonify }},
      "summary": {{ $body.plain | jsonify }},
      "content_html": {{ $body.html | jsonify }},
      "content_text": {{ $body.markdown | jsonify }},
      "date_published": {{ (time.AsTime $e.announced_at).Format "2006-01-02T15:04:05Z07:00" | jsonify }},
      "tags": {{ (slice "reading" "sources" $e.type (printf "%s-reading" $e.event_type)) | jsonify }}
    }
    {{- end }}
  ]
}
