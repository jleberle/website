{{- $authorEmail := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .email }}
      {{- $authorEmail = . }}
    {{- end }}
  {{- end }}
{{- end }}

{{- $authorName := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .name }}
      {{- $authorName = . }}
    {{- end }}
  {{- else }}
    {{- $authorName = . }}
  {{- end }}
{{- end }}

{{- $events := slice -}}
{{- range $entry := partial "reading_entries.html" . }}
    {{- $title := $entry.title | default $entry.slug -}}
    {{- $author := $entry.author | default "" -}}
    {{- $publisher := $entry.publisher | default "" -}}
    {{- $publishedYear := $entry.published_year | default "" -}}
    {{- $isbn := $entry.isbn | default "" -}}
    {{- $format := $entry.format | default "" -}}
    {{- $notes := $entry.notes | default "" -}}
    {{- $containerTitle := $entry.container_title | default "" -}}
    {{- $doi := $entry.doi | default "" -}}
    {{- $url := $entry.url | default "" -}}
    {{- $anchor := printf "%s#%s" $.Permalink $entry.anchor_id -}}
    {{- with $entry.started }}
      {{- $announcedAt := $entry.started_announced | default . -}}
      {{- $events = $events | append (dict
          "slug" $entry.slug
          "anchor_id" $entry.anchor_id
          "type" $entry.type
          "type_label" $entry.type_label
          "title" $title
          "author" $author
          "publisher" $publisher
          "container_title" $containerTitle
          "published_year" $publishedYear
          "isbn" $isbn
          "doi" $doi
          "url" $url
          "format" $format
          "notes" $notes
          "event_type" "started"
          "event_date" .
          "announced_at" $announcedAt
          "sort_key" (printf "%s-0-%s-%s" $announcedAt $entry.type $entry.slug)
          "anchor" $anchor
        ) -}}
    {{- end }}
    {{- with $entry.finished }}
      {{- $announcedAt := $entry.finished_announced | default . -}}
      {{- $events = $events | append (dict
          "slug" $entry.slug
          "anchor_id" $entry.anchor_id
          "type" $entry.type
          "type_label" $entry.type_label
          "title" $title
          "author" $author
          "publisher" $publisher
          "container_title" $containerTitle
          "published_year" $publishedYear
          "isbn" $isbn
          "doi" $doi
          "url" $url
          "format" $format
          "notes" $notes
          "event_type" "finished"
          "event_date" .
          "announced_at" $announcedAt
          "sort_key" (printf "%s-1-%s-%s" $announcedAt $entry.type $entry.slug)
          "anchor" $anchor
        ) -}}
    {{- end }}
{{- end }}

{{- $events = sort $events "sort_key" "desc" -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}
  {{- $events = first $limit $events -}}
{{- end }}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ .Title }} | {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default (printf "Reading activity from %s" site.Title) }}</description>
    {{- with resources.Get "icons/apple-touch-icon.png" }}
    <image>
      <title>{{ site.Title }}</title>
      <url>{{ (. | resources.Fingerprint).Permalink }}</url>
      <link>{{ $.Permalink }}</link>
    </image>
    {{- end }}
    <generator>Hugo</generator>
    <language>{{ site.Language.Lang }}</language>{{ with $authorEmail }}
    <managingEditor>{{.}}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>{{ end }}{{ with $authorEmail }}
    <webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>{{ end }}{{ with site.Copyright }}
    <copyright>{{ . | markdownify | plainify | strings.TrimPrefix "© " }}</copyright>{{ end }}
    {{- if gt (len $events) 0 }}
    <lastBuildDate>{{ (time.AsTime (index $events 0).announced_at).Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- with site.Params.websubHub }}
    {{ printf "<atom:link href=%q rel=\"hub\" />" . | safeHTML }}
    {{- end }}
    {{- range $events }}
    {{- $action := cond (eq .event_type "started") "Started reading" "Finished reading" -}}
    {{- $plainBody := printf "%s: %s" $action .title -}}
    {{- with .author }}{{- $plainBody = printf "%s by %s" $plainBody . -}}{{- end -}}
    {{- with .container_title }}{{- $plainBody = printf "%s in %s" $plainBody . -}}{{- end -}}
    {{- $plainBody = printf "%s. 📚" $plainBody -}}
    {{- with .notes }}{{- $plainBody = printf "%s %s" $plainBody . -}}{{- end -}}
    {{- $linkedTitle := .title | htmlEscape -}}
    {{- if and (eq .type "book") .isbn }}
      {{- $linkedTitle = printf "<a href=%q>%s</a>" (printf "https://micro.blog/books/%s" .isbn) $linkedTitle -}}
    {{- else if .url }}
      {{- $linkedTitle = printf "<a href=%q>%s</a>" .url $linkedTitle -}}
    {{- else if .doi }}
      {{- $linkedTitle = printf "<a href=%q>%s</a>" (printf "https://doi.org/%s" .doi) $linkedTitle -}}
    {{- end -}}
    {{- $htmlBody := printf "%s: %s" $action $linkedTitle -}}
    {{- with .author }}{{- $htmlBody = printf "%s by %s" $htmlBody (. | htmlEscape) -}}{{- end -}}
    {{- with .container_title }}{{- $htmlBody = printf "%s in %s" $htmlBody (. | htmlEscape) -}}{{- end -}}
    {{- $htmlBody = printf "%s. 📚" $htmlBody -}}
    {{- with .notes }}{{- $htmlBody = printf "%s %s" $htmlBody (. | htmlEscape) -}}{{- end -}}
    {{- $content := printf "<p>%s</p>" $htmlBody -}}
    <item>
      <link>{{ .anchor }}</link>
      <pubDate>{{ (time.AsTime .announced_at).Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with $authorEmail }}<author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>{{ end }}
      {{- with $authorName }}<dc:creator>{{ . }}</dc:creator>{{ end }}
      <guid isPermaLink="false">{{ printf "urn:reading-event:%s:%s:%s" .type .slug .event_type }}</guid>
      <description>{{ $plainBody }}</description>
      <category>reading</category>
      <category>sources</category>
      <category>{{ .type }}</category>
      <category>{{ printf "%s-reading" .event_type }}</category>
      <content:encoded>{{ (printf "<![CDATA[%s]]>" $content) | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
