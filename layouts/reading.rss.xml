{{- /* Reading activity feed: one item per started/finished event, built from
       the source term pages under content/sources/.

       Cross-repo contract (asserted by scripts/checks/feed-lint.py): the
       <category> values started-reading / finished-reading and the literal
       "Started reading: " / "Finished reading: " description prefixes are what
       ~/git/micro-theme matches to build eberle.blog's reading sections.
       The guid urn keeps its old shape — urn:reading-event:<type>:<slug>:<event>
       — so items already imported are not re-imported. What changed is <link>:
       an event now points at the source's own page rather than an anchor in
       the ledger. */ -}}
{{- $authorName := site.Params.author }}

{{- $events := slice -}}
{{- range $source := (site.GetPage "/sources").Pages }}
    {{- $p := $source.Params -}}
    {{- $slug := path.Base $source.RelPermalink -}}
    {{- $type := $p.type | default "book" -}}
    {{- $record := dict
        "slug" $slug
        "type" $type
        "title" $source.Title
        "author" ($p.author | default "")
        "isbn" ($p.isbn | default "")
        "doi" ($p.doi | default "")
        "url" ($p.access_url | default "")
        "notes" ($source.Plain | plainify | chomp)
        "permalink" $source.Permalink
      -}}
    {{- with $p.started }}
      {{- $announcedAt := $p.started_announced | default . -}}
      {{- $events = $events | append (merge $record (dict
          "event_type" "started"
          "announced_at" $announcedAt
          "sort_key" (printf "%s-0-%s-%s" $announcedAt $type $slug)
        )) -}}
    {{- end }}
    {{- with $p.finished }}
      {{- $announcedAt := $p.finished_announced | default . -}}
      {{- $events = $events | append (merge $record (dict
          "event_type" "finished"
          "announced_at" $announcedAt
          "sort_key" (printf "%s-1-%s-%s" $announcedAt $type $slug)
        )) -}}
    {{- end }}
{{- end }}

{{- $events = sort $events "sort_key" "desc" -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}
  {{- $events = first $limit $events -}}
{{- end }}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ .Title }} | {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default (printf "Reading activity from %s" site.Title) }}</description>
    {{- with partial "templates/_funcs/feed_icon.html" . }}
    <image>
      <title>{{ site.Title }}</title>
      <url>{{ . }}</url>
      <link>{{ $.Permalink }}</link>
    </image>
    {{- end }}
    <generator>Hugo</generator>
    <language>{{ site.Language.Lang }}</language>{{ with site.Copyright }}
    <copyright>{{ . | markdownify | plainify | strings.TrimPrefix "© " }}</copyright>{{ end }}
    {{- if gt (len $events) 0 }}
    <lastBuildDate>{{ (time.AsTime (index $events 0).announced_at).Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- with site.Params.websubHub }}
    {{ printf "<atom:link href=%q rel=\"hub\" />" . | safeHTML }}
    {{- end }}
    {{- range $events }}
    {{- $action := cond (eq .event_type "started") "Started reading" "Finished reading" -}}
    {{- $plainBody := printf "%s: %s" $action .title -}}
    {{- with .author }}{{- $plainBody = printf "%s by %s" $plainBody . -}}{{- end -}}
    {{- $plainBody = printf "%s. 📚" $plainBody -}}
    {{- with .notes }}{{- $plainBody = printf "%s %s" $plainBody . -}}{{- end -}}
    {{- $linkedTitle := .title | htmlEscape -}}
    {{- if and (eq .type "book") .isbn }}
      {{- $linkedTitle = printf "<a href=%q>%s</a>" (printf "https://micro.blog/books/%s" .isbn) $linkedTitle -}}
    {{- else if .url }}
      {{- $linkedTitle = printf "<a href=%q>%s</a>" .url $linkedTitle -}}
    {{- else if .doi }}
      {{- $linkedTitle = printf "<a href=%q>%s</a>" (printf "https://doi.org/%s" .doi) $linkedTitle -}}
    {{- end -}}
    {{- $htmlBody := printf "%s: %s" $action $linkedTitle -}}
    {{- with .author }}{{- $htmlBody = printf "%s by %s" $htmlBody (. | htmlEscape) -}}{{- end -}}
    {{- $htmlBody = printf "%s. 📚" $htmlBody -}}
    {{- with .notes }}{{- $htmlBody = printf "%s %s" $htmlBody (. | htmlEscape) -}}{{- end -}}
    {{- $content := printf "<p>%s</p>" $htmlBody -}}
    <item>
      <link>{{ .permalink }}</link>
      <pubDate>{{ (time.AsTime .announced_at).Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with $authorName }}<dc:creator>{{ . }}</dc:creator>{{ end }}
      <guid isPermaLink="false">{{ printf "urn:reading-event:%s:%s:%s" .type .slug .event_type }}</guid>
      <description>{{ $plainBody }}</description>
      <category>reading</category>
      <category>sources</category>
      <category>{{ .type }}</category>
      <category>{{ printf "%s-reading" .event_type }}</category>
      <content:encoded>{{ (printf "<![CDATA[%s]]>" $content) | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
