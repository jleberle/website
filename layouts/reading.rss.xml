{{- /* Reading activity feed: one item per started/finished event, built from
       the source term pages under content/sources/.

       Cross-repo contract (asserted by scripts/checks/feed-lint.py): the
       <category> values started-reading / finished-reading and the literal
       "Started reading: " / "Finished reading: " description prefixes are what
       ~/git/micro-theme matches to build eberle.blog's reading sections.

       A guid is urn:reading-event:<type>:<key>:<event>, where <key> is a
       STABLE identifier for the work — isbn, then doi, then access_url — NOT
       the source's folder name. Renaming a source folder used to rewrite every
       guid it had ever emitted, and Micro.blog would re-import any event still
       inside the feed window as if it were new (root cause of the
       2026-07 duplicate-post cleanup on eberle.blog). Keying on the work's own
       identifier means a rename is guid-invisible for any source that has one.
       Only the ~2 sources with none of isbn/doi/access_url fall back to the
       folder slug, so renaming THOSE still re-imports — same old risk, now
       scoped to a known-small set instead of every source.

       THE <link> IS THE ONE THAT ACTUALLY CONTROLS DUPLICATION, not the guid
       (see the next paragraph). Once an item has gone out, treat its <link> as
       immutable: scripts/checks/feed-lint.py fails the build if a published one
       changes, and scripts/checks/reading-feed-links.json is the record of what
       has been published. The feed window (services.rss.limit in hugo.yaml,
       currently 10, was 20) is the blast radius — it bounds how many duplicate
       posts a slipped link change can create, and how long a deleted post stays
       deleted, since Micro.blog re-creates any item it still sees with no
       matching post. docs/reading.md has the full workflow.

       <link> points at the source's own page. Micro.blog's importer appears
       to dedupe on <link> rather than <guid>: when The Blood Countess got
       both a started and a finished event (2026-06/2026-08), sharing one
       <link> across the two, only the first ever imported — the second was
       silently dropped even though the feed and the WebSub/ping delivery
       were both confirmed correct.

       The fix is asymmetric, not "suffix whichever events currently
       collide": a started event gets #started unconditionally, the moment
       `started` exists, whether or not `finished` has been added yet. A
       finished event gets #finished only when that source also has
       `started` set. Conditioning on "do both exist right now" instead would
       mean a book's started link is bare while only-started, then changes
       out from under an already-imported post the day `finished` is added —
       recreating this exact bug, forever, once per book. Anchoring #started
       to `started` alone means that link is fixed for good the moment it is
       first published. `started` is also a new, rare field (2 of ~60
       sources), so this costs at most one small, one-time reimport per
       newly-tracked "currently reading" book, not the whole-window mass
       reimport that suffixing every finished event unconditionally would
       cause — nearly every past source is finished-only and would otherwise
       all appear to change at once. */ -}}
{{- $authorName := site.Params.author }}

{{- $events := partial "templates/_funcs/reading_events.html" . -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}
  {{- $events = first $limit $events -}}
{{- end }}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ .Title }} | {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default (printf "Reading activity from %s" site.Title) }}</description>
    {{- with partial "templates/_funcs/feed_icon.html" . }}
    <image>
      <title>{{ site.Title }}</title>
      <url>{{ . }}</url>
      <link>{{ $.Permalink }}</link>
    </image>
    {{- end }}
    <generator>Hugo</generator>
    <language>{{ site.Language.Lang }}</language>{{ with site.Copyright }}
    <copyright>{{ . | markdownify | plainify | strings.TrimPrefix "© " }}</copyright>{{ end }}
    {{- if gt (len $events) 0 }}
    <lastBuildDate>{{ (time.AsTime (index $events 0).announced_at).Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- with site.Params.websubHub }}
    {{ printf "<atom:link href=%q rel=\"hub\" />" . | safeHTML }}
    {{- end }}
    {{- range $events }}
    {{- $body := partial "templates/_funcs/reading_item_body.html" . -}}
    <item>
      <link>{{ .permalink }}{{ with .linkSuffix }}#{{ . }}{{ end }}</link>
      <pubDate>{{ (time.AsTime .announced_at).Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with $authorName }}<dc:creator>{{ . }}</dc:creator>{{ end }}
      <guid isPermaLink="false">{{ printf "urn:reading-event:%s:%s:%s" .type .key .event_type }}</guid>
      <description>{{ $body.plain }}</description>
      <category>reading</category>
      <category>sources</category>
      <category>{{ .type }}</category>
      <category>{{ printf "%s-reading" .event_type }}</category>
      {{- /* $body.html's title/author/notes are htmlEscape'd, but the <a href>
             built from .url/.doi inside reading_item_body.html is not — a
             literal "]]>" reaching this CDATA from an access_url or DOI would
             still close it early. Same CDATA-safe escape as the main feed
             (layouts/rss.xml). */ -}}
      <content:encoded>{{ (printf "<![CDATA[%s]]>" (replace $body.html "]]>" "]]]]><![CDATA[>")) | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
