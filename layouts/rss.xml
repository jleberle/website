{{- $authorEmail := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .email }}
      {{- $authorEmail = . }}
    {{- end }}
  {{- end }}
{{- end }}

{{- $authorName := "" }}
{{- with site.Params.author }}
  {{- if reflect.IsMap . }}
    {{- with .name }}
      {{- $authorName = . }}
    {{- end }}
  {{- else }}
    {{- $authorName  = . }}
  {{- end }}
{{- end }}

{{- $base := site.BaseURL | strings.TrimSuffix "/" }}
{{- /* Keep this set in lockstep with the JSON feed: same content sections,
       hiddenInRss opt-out, and item limit. */ -}}
{{- $pages := where site.RegularPages "Type" "in" site.Params.contentSections }}
{{- $pages = where $pages "Params.hiddenInRss" "!=" true -}}
{{- $limit := site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
{{- $pages = $pages | first $limit }}
{{- end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content on {{ site.Title }}</description>
    {{- /* Feed readers (e.g. NetNewsWire) pull the channel <image>; it must be
           square and at least ~128px. site.Params.images is the 1000x688 OG card,
           so use the square single-source site icon instead. */ -}}
    {{- with resources.Get "icons/apple-touch-icon.png" }}
    <image>
      <title>{{ site.Title }}</title>
      <url>{{ (. | resources.Fingerprint).Permalink }}</url>
      <link>{{ $.Permalink }}</link>
    </image>
    {{- end }}
    <generator>Hugo</generator>
    <language>{{ site.Language.Lang }}</language>{{ with $authorEmail }}
    <managingEditor>{{.}}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>{{ end }}{{ with $authorEmail }}
    <webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>{{ end }}{{ with site.Copyright }}
    <copyright>{{ . | markdownify | plainify | strings.TrimPrefix "© " }}</copyright>{{ end }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- $page := . }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with $authorEmail }}<author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>{{ end }}
      <guid isPermaLink="false">{{ .Permalink }}</guid>
      <description>{{ partial "page_summary.html" . | html }}</description>
      {{- if and site.Params.rssFullContent .Content }}
      {{- /* Absolutize root-relative URLs and drop feed-irrelevant responsive/
             lightbox attributes so images resolve in feed readers. Fragment-only
             links (mostly footnotes) also need the page URL in syndicated HTML. */ -}}
      {{- $c := .Content
            | replaceRE `\s+(srcset|sizes|data-lightbox-src|loading|decoding)="[^"]*"` ""
            | replaceRE `href="#([^"]*)"` (printf `href="%s#$1"` .Permalink)
            | replaceRE `(src|href)="(/[^"]*)"` (printf `$1="%s$2"` $base) }}
      {{- /* Lead with the frontmatter cover image (PaperMod renders it outside
             .Content, so it's otherwise absent), unless the body embeds it. */ -}}
      {{- with $page.Params.cover.image }}
      {{- $cover := "" }}
      {{- /* Fingerprint so the feed shares the one content-hashed cover file with
             the page/schema rather than publishing a second raw copy. */ -}}
      {{- with $page.Resources.GetMatch . }}{{ $cover = (. | resources.Fingerprint).Permalink }}{{ else }}{{ $cover = print $page.Permalink . }}{{ end }}
      {{- $stem := strings.TrimSuffix (path.Ext .) (path.Base .) }}
      {{- if not (strings.Contains $c (printf "/%s." $stem)) }}
      {{- $alt := $page.Params.cover.alt | default $page.Title }}
      {{- $c = printf "<img src=%q alt=%q>\n%s" $cover $alt $c }}
      {{- end }}
      {{- end }}
      <content:encoded>{{ (printf "<![CDATA[%s]]>" $c) | safeHTML }}</content:encoded>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
