{
  "name": "jaredeberle-website",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling for jaredeberle.org (Hugo site). Single source of truth for validation dependencies used by GitHub Actions and scripts/preflight.sh.",
  "scripts": {
    "validate": "hugo --minify && html-validate \"public/**/*.html\" && stylelint \"assets/css/**/*.css\"",
    "test:axe": "node scripts/checks/axe-check.mjs public"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "html-validate": "^11.5.5",
    "playwright": "^1.61.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
